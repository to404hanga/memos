{
  "name": "memo-reminder",
  "productName": "备忘录",
  "version": "1.0.1-beta.0",
  "description": "桌面备忘录提醒应用",
  "main": "dist/main/index.js",
  "bin": {
    "memo": "./cli.js"
  },
  "scripts": {
    "build:main": "npx webpack --config webpack.main.config.js",
    "build:main:dev": "NODE_ENV=development npx webpack --config webpack.main.config.js",
    "build:renderer": "npx webpack build --mode production",
    "build": "npm run build:renderer && npm run build:main",
    "start": "npm run build:main && electron .",
    "dev": "concurrently \"npx webpack serve --mode development\" \"wait-on http://localhost:3000 && npm run build:main:dev && DEV_SERVER=1 electron .\"",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:win": "npm run build && electron-builder --win",
    "dist:linux": "npm run build && electron-builder --linux"
  },
  "dependencies": {
    "adm-zip": "^0.5.17",
    "commander": "^14.0.3",
    "dompurify": "^3.4.5",
    "marked": "^18.0.3",
    "sql.js": "^1.14.1",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@babel/preset-env": "^7.24.0",
    "@babel/preset-react": "^7.23.3",
    "@types/node": "^20.19.41",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/uuid": "^10.0.0",
    "babel-loader": "^9.1.3",
    "concurrently": "^8.2.2",
    "css-loader": "^6.10.0",
    "electron": "^28.2.0",
    "electron-builder": "^26.8.1",
    "electron-rebuild": "^3.2.9",
    "electronmon": "^2.0.4",
    "html-webpack-plugin": "^5.6.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "style-loader": "^3.3.4",
    "ts-loader": "^9.5.7",
    "typescript": "5.8",
    "wait-on": "^7.2.0",
    "webpack": "^5.90.0",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^5.0.0"
  },
  "build": {
    "appId": "com.memo.reminder",
    "productName": "备忘录",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "preload.js",
      "assets/**/*",
      "node_modules/sql.js/dist/sql-wasm.wasm"
    ],
    "extraResources": [
      {
        "from": "node_modules/sql.js/dist/sql-wasm.wasm",
        "to": "sql-wasm.wasm"
      }
    ],
    "mac": {
      "icon": "assets/icon.icns",
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.productivity"
    },
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "备忘录"
    },
    "linux": {
      "icon": "assets/icon.png",
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Utility"
    }
  }
}
