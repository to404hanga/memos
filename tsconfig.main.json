{
  "compilerOptions": {
    "module": "commonjs",
    "target": "ES2022",
    "outDir": "./dist/main",
    "rootDir": "./src/main",
    "declaration": false,
    "noEmit": false,
    "strict": true,
    "noImplicitAny": false,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "moduleResolution": "node",
    "lib": ["ES2022"],
    "types": ["node"]
  },
  "include": ["src/main/**/*", "types/**/*"],
  "exclude": ["node_modules", "dist"]
}
